# Testing environment — non-secret configuration only.
# Copy values into the GitHub Environment named `testing` as Variables.

ENVIRONMENT=testing
AWS_REGION=us-east-1
ECS_CLUSTER=testing-cluster
ECR_REGISTRY=<aws-account-id>.dkr.ecr.us-east-1.amazonaws.com
VITE_API_URL=https://api.test.marketplace.example.com
HEALTH_CHECK_TIMEOUT_SECONDS=240
SMOKE_TEST_URL=https://api.test.marketplace.example.com

# Configure these as GitHub Environment Secrets; never commit their values:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# SLACK_WEBHOOK_URL